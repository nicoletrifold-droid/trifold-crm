# packages/web/.env.development.example — Story 900-3b (AC2)
#
# SÓ NOMES. Nenhum valor, nunca. Este arquivo é RASTREADO pelo git — ele só é versionável
# porque a Task 1 desta story consertou o `.gitignore` (a negação `!.env.development.example`
# mora em `packages/web/.gitignore`, depois da regra ampla `.env*`; negação equivalente na
# raiz NÃO funciona, porque o `.gitignore` mais próximo do arquivo vence).
#
# Lista derivada pelo comando da AC2, aplicado ao sucessor de `.env.local`
# (`packages/web/.env.producao.local`), restrito ao conteúdo anterior ao marcador de
# mesclagem — isto é, exatamente o conjunto que `.env.local` tinha:
#
#   grep -o '^[A-Z_][A-Z0-9_]*=' packages/web/.env.producao.local | sed 's/=$//' | sort -u
#
# A âncora casa até o `=`; o valor nunca entra na captura.
#
# ONDE FICAM OS ARQUIVOS DE VALOR (todos gitignored):
#   packages/web/.env.development     → TESTE  (`xnxvygyfyyyzwhiuoehz`) — default do `pnpm dev`
#   packages/web/.env.producao.local  → PRODUÇÃO — só via `pnpm dev:prod`
#
# O QUE O AMBIENTE DE TESTE PREENCHE, HOJE: apenas as 5 variáveis de Supabase marcadas
# `[teste]` abaixo. As demais ficam DELIBERADAMENTE ausentes — preenchê-las apontaria um
# boot de teste para contas reais de Meta/Resend/Telegram/Sienge/Google. Ausente é um
# estado honesto; string vazia não é.
#
# NODE_ENV está na lista porque o comando o capturou do arquivo de produção. O Next o
# define sozinho — não o defina à mão em `.env.development`.

AIOS_VERSION=
ANTHROPIC_API_KEY=
CLICKUP_API_KEY=
CONTEXT7_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
EXA_API_KEY=
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
N8N_API_KEY=
N8N_WEBHOOK_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # [teste] preencher no painel Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=            # [teste] preencher no painel Supabase → Project Settings → API
NODE_ENV=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
RAILWAY_TOKEN=
RESEND_API_KEY=
SENTRY_DSN=
SIENGE_PASSWORD=
SIENGE_SUBDOMAIN=
SIENGE_USERNAME=
SUPABASE_SERVICE_ROLE_KEY=            # [teste] preencher no painel Supabase → Project Settings → API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VERCEL_TOKEN=
SUPABASE_ANON_KEY=  # [teste] alias legado consumido por scripts/
SUPABASE_URL=       # [teste] alias sem prefixo NEXT_PUBLIC_, consumido por scripts/
